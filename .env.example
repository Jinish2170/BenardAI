# --- LLM (OpenAI-compatible, defaults to NVIDIA NIM free tier) ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your-key-here
LLM_MODEL=meta/llama-3.3-70b-instruct

# --- Threat intel (all optional; Bernard degrades gracefully if missing) ---
# VirusTotal free tier: 4 requests/minute, 500/day — https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# AbuseIPDB free tier: 1000 requests/day — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# abuse.ch (URLhaus / MalwareBazaar / ThreatFox) — free, no key required for public feeds
# Optional auth key for higher quotas: https://auth.abuse.ch/
ABUSECH_API_KEY=

# --- Server ---
PORT=3003

# --- Tuning ---
MAX_UPLOAD_MB=100
ANALYSIS_TIMEOUT_S=120
